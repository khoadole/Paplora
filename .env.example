# Optional future integration. The local workspace works without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Required for paper discovery and evidence extraction.
# Never exposed to the browser and never written to logs.
OPENAI_API_KEY=

# The model used for discovery, extraction and summaries. No default is assumed:
# an unverified model name would misreport what produced your answers.
# Discovery needs a model whose account has the Responses API web_search tool.
OPENAI_MODEL=

# Compatibility alias from an earlier configuration. Used only when OPENAI_MODEL is empty.
OPENAI_LESSON_MODEL=

# Optional contact address for the OpenAlex polite pool (a courtesy, not a key).
OPENALEX_MAILTO=
