# Optional future integration. Local workspace works without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-side only. Required only for live AI extraction.
OPENAI_API_KEY=

# Optional model override for paper extraction.
OPENAI_MODEL=

# Compatibility alias from the owner's existing configuration.
# Used only when OPENAI_MODEL is empty. Paplora does not generate lessons.
OPENAI_LESSON_MODEL=
